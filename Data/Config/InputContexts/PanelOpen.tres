[gd_resource type="Resource" script_class="InputContext" load_steps=2 format=3]

[ext_resource type="Script" path="res://Script/Input/InputContext.gd" id="1_ctx"]

[resource]
script = ExtResource("1_ctx")
context_id = &"PanelOpen"
explicit_allowed = [&"ui_panel_build", &"combat_interact"]
explicit_blocked = [
	&"combat_attack", &"combat_skill_q", &"combat_skill_w", &"combat_skill_e", &"combat_skill_r",
	&"combat_ultimate", &"combat_dodge", &"combat_block", &"combat_swap", &"combat_consumable",
]
allow_all = false
display_name = "面板打开（屏蔽战斗，允许 UI 导航）"
