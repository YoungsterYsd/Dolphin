; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dolphin"
run/main_scene="res://Scenes/Levels/ItemTestArena.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
run/log/file_logging/enable_file_logging=true
run/log/file_logging/enable_file_logging.pc=true

[autoload]

ConfigCenter="*res://Script/Core/ConfigCenter.gd"
EventBus="*res://Script/Core/EventBus.gd"
GameInstance="*res://Script/Core/GameInstance.gd"
LevelManager="*res://Script/GameFramework/LevelManager.gd"
AudioManager="*res://Script/Audio/AudioManager.gd"
SettingsManager="*res://Script/Settings/SettingsManager.gd"
InputContextManager="*res://Script/Input/InputContextManager.gd"
HUDManager="*res://Script/UI/HUDManager.gd"
UIExtensionSubsystem="*res://Script/UI/UIExtensionSubsystem.gd"
HUDStateMachine="*res://Script/UI/HUDStateMachine.gd"
ComboTracker="*res://Script/UI/ComboTracker.gd"
DialogueRunner="*res://Script/Dialogue/DialogueRunner.gd"
QuestSystem="*res://Script/Quest/QuestSystem.gd"
HUDDebugCheats="*res://Script/UI/HUDDebugCheats.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/skill_editor/plugin.cfg")

